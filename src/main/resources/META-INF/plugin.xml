<idea-plugin>
    <id>dev.classgraph</id>
    <name>Caldo Graph</name>
    <vendor>Caldo Graph</vendor>
    <description><![CDATA[
        Interactive UML-style graph of the classes and composables of a Kotlin / Android project.
        Drag declarations into the Caldo Graph tool window and expand their relations.
    ]]></description>

    <dependencies>
        <plugin id="com.intellij.modules.platform"/>
        <plugin id="org.jetbrains.kotlin"/>
        <plugin id="com.intellij.modules.jcef"/>
        <module name="intellij.platform.ui.jcef"/>
        <module name="intellij.libraries.jcef"/>
    </dependencies>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK1="true" supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Caldo Graph"
                    anchor="left"
                    icon="/icons/classGraph.svg"
                    factoryClass="dev.classgraph.toolwindow.ClassGraphToolWindowFactory"/>
        <notificationGroup id="Caldo Graph" displayType="BALLOON"/>
        <projectConfigurable parentId="tools"
                             instance="dev.classgraph.settings.ClassGraphConfigurable"
                             id="dev.classgraph.settings"
                             displayName="Caldo Graph"
                             nonDefaultProject="true"/>
    </extensions>

    <actions>
        <action id="ClassGraph.AddToGraph"
                class="dev.classgraph.actions.AddToClassGraphAction"
                text="Add to Caldo Graph"
                description="Add the selected class or composable to the Caldo Graph"
                icon="/icons/classGraph.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="StructureViewPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift G"/>
        </action>
    </actions>
</idea-plugin>
